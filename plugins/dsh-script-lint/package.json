{
  "name": "dsh-script-lint",
  "version": "0.2.0",
  "description": "DSH 插件：在 write/edit 缝上拦住踩过的 shell / PowerShell 坑（set -e 命令替换陷阱、递归 grep 裸变量、.ps1 缺 BOM）",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./rules": "./src/rules.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shell",
    "assertion",
    "lint"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
