{
  "name": "dsh-skill-lint",
  "version": "0.1.0",
  "description": "SKILL.md 确定性断言：写入前后校验 frontmatter（name/description/布尔键）与体积，不过则 deny / block 并把修正意见回喂模型",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./lint": "./src/lint.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "assertion",
    "eval"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
